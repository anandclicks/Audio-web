// RoadTunes database schema
//
// Production (Vercel): Postgres for the database + Vercel Blob for the media files.
//   - DATABASE_URL is a Postgres connection string (Vercel Postgres / Neon / Supabase).
//   - Tables are created automatically at build time via `prisma db push` (see package.json).
//   - Uploaded audio/poster files live in Vercel Blob; the DB stores their public URLs.
//
// Local dev with SQLite instead: set provider = "sqlite" and
// DATABASE_URL="file:./dev.db", then run `npx prisma db push`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One uploaded song. Audio + optional poster are stored in Vercel Blob; `audioFile`
// and `posterFile` hold their public Blob URLs. `order` controls the playback sequence.
model Song {
  id         String   @id @default(cuid())
  title      String
  artist     String
  audioFile  String
  audioMime  String
  posterFile String?
  posterMime String?
  durationMs Int      @default(0)
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([order])
}
