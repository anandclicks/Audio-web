// RoadTunes database schema
//
// Production (Vercel): Postgres for the database + Vercel Blob for the media files.
//   - DATABASE_URL is a Postgres connection string (Vercel Postgres / Neon / Supabase).
//   - Tables are created automatically at build time via `prisma db push` (see package.json).
//   - Uploaded audio/poster files live in Vercel Blob; the DB stores their public URLs.
//
// Local dev with SQLite instead: set provider = "sqlite" and
// DATABASE_URL="file:./dev.db", then run `npx prisma db push`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Supabase (via the Vercel integration) creates these two automatically:
  //   POSTGRES_PRISMA_URL      → pooled connection, used for app queries
  //   POSTGRES_URL_NON_POOLING → direct connection, used for `prisma db push`
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// One uploaded song. Audio + optional poster are stored in Vercel Blob; `audioFile`
// and `posterFile` hold their public Blob URLs. `order` controls the playback sequence.
model Song {
  id         String   @id @default(cuid())
  title      String
  artist     String
  audioFile  String
  audioMime  String
  posterFile String?
  posterMime String?
  durationMs Int      @default(0)
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([order])
}

// Simple key/value store for app-wide settings (e.g. the player's background image
// URL, which the admin can change). Values are small strings such as a Blob URL.
model Setting {
  key   String @id
  value String
}
