# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local
.env.production

# database
# NOTE: dev.db is intentionally committed so it deploys as a read-only snapshot.
# Only the temporary journal/WAL sidecar files are ignored.
/prisma/*.db-journal
/prisma/*.db-wal
/prisma/*.db-shm

# uploaded media
# NOTE: data/uploads is intentionally committed so audio/posters deploy with the app.
/data/tmp

# typescript
*.tsbuildinfo

# vercel
.vercel
