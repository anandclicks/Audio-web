# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local
.env.production

# database
# Production uses Postgres; any local SQLite dev file stays out of git.
/prisma/*.db
/prisma/*.db-journal
/prisma/*.db-wal
/prisma/*.db-shm

# uploaded media
# Production uses Vercel Blob; local uploads (if any) stay out of git.
/data

# typescript
*.tsbuildinfo

# vercel
.vercel
