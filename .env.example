# ─────────────────────────────────────────────────────────────
#  RoadTunes environment variables
#  Copy this file to `.env` and fill in the values.
# ─────────────────────────────────────────────────────────────

# --- Admin login ---
# The password you type at /admin to manage songs. Choose something strong.
ADMIN_PASSWORD=change_me

# Signs the admin session cookie. Generate with:  openssl rand -base64 32
ADMIN_SESSION_SECRET=generate_a_long_random_string

# --- Database ---
# SQLite (default): a local file. Great for dev / self-hosted / VPS.
DATABASE_URL="file:./dev.db"
# For Postgres/Supabase, change the datasource provider in prisma/schema.prisma to
# "postgresql" and set, e.g.:
# DATABASE_URL="postgresql://user:pass@host:5432/roadtunes?schema=public"

# --- Uploads (optional) ---
# Where uploaded audio + poster files are stored. Defaults to ./data/uploads.
# Point this at a mounted volume when deploying to a VPS.
# UPLOAD_DIR=./data/uploads
