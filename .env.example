# ─────────────────────────────────────────────────────────────
#  RoadTunes environment variables
#  Copy this file to `.env` and fill in the values.
#  On Vercel, set these in Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# --- Admin login ---
# The password you type at /admin to manage songs. Choose something strong.
ADMIN_PASSWORD=change_me

# Signs the admin session cookie. Generate with:  openssl rand -base64 32
ADMIN_SESSION_SECRET=generate_a_long_random_string

# --- Database (Supabase Postgres) ---
# The Supabase Vercel integration creates these automatically. Tables are created
# at build time (`prisma db push`, which uses the non-pooling URL).
#   POSTGRES_PRISMA_URL      → pooled connection (app queries)
#   POSTGRES_URL_NON_POOLING → direct connection (migrations / db push)
POSTGRES_PRISMA_URL="postgresql://...pooler...:6543/postgres?pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://...:5432/postgres?sslmode=require"

# --- File storage (Vercel Blob) ---
# Uploaded audio + posters are stored in Vercel Blob. Create a Blob store in the
# Vercel dashboard (Storage → Create → Blob) and this token is added automatically.
# For local dev, copy it from the Blob store's ".env" tab.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
